+
+// AI bridge hooks: the small surface bridge.c needs from this file.
+
+void bridgeLoadLevel(uint8_t levelNumber, uint16_t seed)
+{
+    gIsPlayingDemo = 0;
+    gIsSPDemoAvailableToRun = 0;
+    gSelectedOriginalDemoLevelNumber = 0;
+    gSelectedOriginalDemoFromCommandLineLevelNumber = 0;
+    gHasUserCheated = 1; // No player stats or hall of fame writes
+    gShouldUpdateTotalLevelTime = 0;
+    gCurrentSelectedLevelIndex = levelNumber;
+    byte_5A19B = 0;
+
+    fetchAndInitializeLevel();
+
+    // Same per-run setup as the top of runLevel()
+    gIsLevelStartedAsDemo = 0;
+    gLevelFailed = 1;
+    gPlantedRedDiskCountdown = 0;
+    byte_5A323 = 0;
+    gCurrentUserInput = UserInputNone;
+    gRandomGeneratorSeed = seed;
+}
+
+void bridgeSetUserInput(uint8_t input)
+{
+    gCurrentUserInput = (input <= UserInputSpaceOnly ? input : UserInputNone);
+}
+
+uint16_t bridgeGetRandomGeneratorSeed()
+{
+    return gRandomGeneratorSeed;
+}
+
+uint8_t bridgeIsLevelCompleted()
+{
+    return byte_5A19B;
 }
